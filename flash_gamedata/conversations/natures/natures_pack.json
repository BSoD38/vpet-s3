              "happiness": 2,
              "drift": {
                "social": 0.3
              }
            }
          }
        ]
      },
      {
        "id": "sit",
        "text": "Then we agree. That's the most I needed from today."
      },
      {
        "id": "talk",
        "text": "Oh. Then I suppose I'm listening. Go on."
