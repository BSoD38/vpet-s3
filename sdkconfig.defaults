CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE=64

CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_ANSI_OEM=y
# Two FAT volumes mounted at once: SD card (/sdcard) + flash creatures partition (/creatures)
# Three FAT volumes are mounted simultaneously whenever an SD card is present: the card itself,
# the `creatures` partition, and `gamedata`. At the default of 2 the third mount fails with
# ESP_ERR_NO_MEM, and because every registry degrades gracefully to its built-in fallback the
# symptom is silent: inserting an SD card would wipe out foods, natures, personalities AND
# conversations while the game carried on as if nothing were wrong. 4 leaves room for one more
# asset partition; unused slots cost nothing (the allocation is per MOUNTED volume).
CONFIG_FATFS_VOLUME_COUNT=4

# Every mounted mod pack (engine/pakfs) registers its own VFS root on top of the console
# devices, /dev/null, /sdcard and /gamedata -- at the default of 8 the FIRST SD mod pack
# already fails to register (ESP_ERR_NO_MEM at boot, base.pak having taken the last slot)
# and its content silently never loads. Same trap as FATFS_VOLUME_COUNT above, one layer
# down. Worst case today is 11 (3 console + null + 2 mounts + 5 paks); 16 leaves headroom
# and unused slots cost one pointer each.
CONFIG_VFS_MAX_COUNT=16

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 1 kHz FreeRTOS tick: 10 ms ticks (100 Hz default) quantize the game loop's
# vTaskDelay(1) waits and cap the frame rate at ~50 FPS; 1 ms ticks give 60 FPS.
CONFIG_FREERTOS_HZ=1000

# Build with -O2 to roughly halve software render time.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

#CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
#CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
#CONFIG_SPIRAM_MODE_OCT=y

#CONFIG_IDF_EXPERIMENTAL_FEATURES=y
#CONFIG_SPIRAM_SPEED_120M=y

#CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
#CONFIG_SPIRAM_RODATA=y
#CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
#CONFIG_COMPILER_OPTIMIZATION_PERF=y